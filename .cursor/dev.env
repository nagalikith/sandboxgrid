# Development environment variables for sandboxgrid Cloud Agents.
# These are non-production, dev-only defaults (mirrors docker-compose.yml).
export DATABASE_URL="${DATABASE_URL:-sqlite:////workspace/.devdata/sandbox.db}"
export INTERNAL_AUTH_SECRET="${INTERNAL_AUTH_SECRET:-dev-internal-secret}"
export SANDBOX_ARTIFACTS_ROOT="${SANDBOX_ARTIFACTS_ROOT:-/workspace/.devdata/artifacts}"
export RABBITMQ_URL="${RABBITMQ_URL:-amqp://guest:guest@localhost:5672/}"
export SANDBOX_PROVISIONER="${SANDBOX_PROVISIONER:-local}"
export API_BASE_URL="${API_BASE_URL:-http://localhost:8000}"
export SANDBOX_PUBLIC_HOST="${SANDBOX_PUBLIC_HOST:-http://localhost}"
